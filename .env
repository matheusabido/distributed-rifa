# Copie este arquivo para ".env" e troque os valores.
#   cp .env.example .env
# O .env NÃO vai para o git (está no .gitignore), porque tem segredos.

# --- Bancos (db1 e db2) ---
# Senha do usuário postgres E do usuário replicator (o db2 usa para copiar o db1).
POSTGRES_PASSWORD=teste
DB_NAME=rifa

# --- Compartilhado por TODAS as APIs ---
# Tem que ser o mesmo em todas, senão o token de uma não vale na outra.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
CORS_ORIGINS=*
