# Copie este arquivo para ".env" e troque os valores.
#   cp .env.example .env
# O .env NÃO vai para o git (está no .gitignore), porque tem segredos.

# --- Bancos (sobem pelo docker-compose-db.yml) ---
# Tem que bater com a senha configurada lá (POSTGRES_PASSWORD).
POSTGRES_PASSWORD=teste
DB_NAME=rifa
# Onde as APIs acham os bancos (primeiro = preferido). O padrão serve quando
# db1 e db2 estão na rede rifa_network desta máquina.
# DB_HOSTS=db1:5432,db2:5432

# --- Compartilhado por TODAS as APIs ---
# Tem que ser o mesmo em todas, senão o token de uma não vale na outra.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
CORS_ORIGINS=*
